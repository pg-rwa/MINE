{
  "name": "mine-super-app",
  "version": "0.1.0",
  "private": true,
  "description": "MINE - My Intelligent Network of Everything. A personal super app powered by AI agents.",
  "workspaces": [
    "packages/core",
    "packages/agents",
    "packages/api",
    "packages/app",
    "packages/sdk"
