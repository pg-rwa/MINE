{
  "name": "mine-super-app",
  "version": "0.1.0",
  "private": true,
  "description": "MINE - My Intelligent Network of Everything. A personal super app powered by AI agents.",
  "workspaces": [
    "packages/core",
    "packages/agents",
    "packages/api",
    "packages/sdk"
  ],
  "scripts": {
    "dev": "tsx watch packages/api/src/index.ts",
    "start": "tsx packages/api/src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/packages/api/src/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "zod": "^3.24.0",
    "uuid": "^11.1.0",
    "eventemitter3": "^5.0.1",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.0.0"
  }
}
