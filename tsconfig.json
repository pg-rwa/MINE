{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "jsx": "react-jsx"
  },
  "references": [
    { "path": "./packages/core" },
    { "path": "./packages/agents" },
    { "path": "./packages/api" },
    { "path": "./packages/app" },
    { "path": "./packages/sdk" }
  ]
}
